{
  "installCommand": "git clone https://github.com/flutter/flutter.git -b 3.29.3 --depth 1 && flutter/bin/flutter doctor && flutter/bin/flutter config --enable-web",
  "buildCommand": "flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://mockmate-001-site1.mtempurl.com/api/:path*"
    },
    {
      "source": "/interview-sessions/:path*",
      "destination": "http://mockmate-001-site1.mtempurl.com/interview-sessions/:path*"
    },
    {
      "source": "/interviews/:path*",
      "destination": "http://mockmate-001-site1.mtempurl.com/interviews/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "http://mockmate-001-site1.mtempurl.com/users/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}